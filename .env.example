# Copy this file to .env and fill in your real key.
# .env is gitignored -- never commit real keys.

# Default provider is Google Gemini (has a usable free tier -- get a key at
# https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-key-here

# To use Claude instead, uncomment these and set GSR_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GSR_LLM_PROVIDER=anthropic

# Optional model overrides (defaults are set per-provider in agent/llm.py)
# GSR_CLASSIFY_MODEL=gemini-3.5-flash-lite
# GSR_AGENT_MODEL=gemini-3.5-flash-lite
